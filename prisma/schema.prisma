// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Seed configuration
// Run with: npm run db:seed

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User and Authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  image     String?
  role      String   @default("STUDENT") // Legacy field - kept for backward compatibility
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  permissions         UserPermission[]
  roles               UserRole[]
  student             Student?
  staff               Staff?
  parent              Parent?
  announcements       Announcement[]
  fees                Fee[]
  inventory           InventoryTransaction[]
  exams               Exam[]
  signature           Signature?
  submittedResults    Result[]               @relation("SubmittedResults")
  reviewedResults     Result[]               @relation("ReviewedResults")
  approvedResults     Result[]               @relation("ApprovedResults")
  generatedReports    StudentReport[]        @relation("ReportGenerator")
  submittedReports    StudentReport[]        @relation("ReportSubmitter")
  approvedReports     StudentReport[]        @relation("ReportApprover")
  auditTrails         AuditTrail[]
  sessionLogs         SessionLog[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  createdApplications Application[]          @relation("ApplicationCreator")
  approvedApplications Application[]         @relation("ApplicationApprover")
  examSubmissionReviews ExamResultSubmission[] @relation("ExamSubmissionReviewer")
  examSubmissionApprovals ExamResultSubmission[] @relation("ExamSubmissionApprover")
  subjectSubmissions  ExamSubjectSubmission[] @relation("SubjectSubmitter")
}

// Dynamic Roles - Users can create custom roles
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

// Permissions - Define what actions can be performed on modules
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  module      String // e.g., "students", "fees", "results"
  action      String // e.g., "create", "read", "update", "delete"
  createdAt   DateTime @default(now())

  userPermissions UserPermission[]
  rolePermissions RolePermission[]
}

// Assign permissions directly to users (for fine-grained control)
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

// Assign permissions to roles
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// Assign roles to users
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// Student Management
model Student {
  id               String   @id @default(cuid())
  admissionNumber  String   @unique
  userId           String   @unique
  dateOfBirth      DateTime
  gender           String
  address          String?
  enrollmentDate   DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE, GRADUATED, TRANSFERRED, DROPPED
  bloodGroup       String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classEnrollment    ClassEnrollment[]
  applications       Application[]
  parents            StudentParent[]
  attendance         Attendance[]
  results            Result[]
  fees               Fee[]
  studentAssignments StudentAssignment[]       @relation("StudentAssignments")
  subjectSelections  StudentSubjectSelection[]
  reports            StudentReport[]
}

// Application Management - Intent to Enroll
model Application {
  id                 String   @id @default(cuid())
  studentId          String
  appliedClassId     String
  appliedSectionId   String?  // Optional, can be assigned during approval
  academicYearId     String
  applicationStatus  String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes              String?  // Additional notes or requirements
  rejectionReason    String?  // Reason if rejected
  createdBy          String   // Teacher/Admin who created the application
  approvedBy         String?  // Admin/Head who approved
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  appliedClass   Class        @relation(fields: [appliedClassId], references: [id], onDelete: Cascade)
  appliedSection Section?     @relation(fields: [appliedSectionId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  creator        User         @relation("ApplicationCreator", fields: [createdBy], references: [id])
  approver       User?        @relation("ApplicationApprover", fields: [approvedBy], references: [id])

  @@unique([studentId, appliedClassId, academicYearId])
  @@index([studentId])
  @@index([applicationStatus])
  @@index([academicYearId])
}

// Parent Management
model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  occupation String?
  income     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentParent[]
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  relation  String // MOTHER, FATHER, GUARDIAN
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

// Class and Section Management
model Class {
  id        String   @id @default(cuid())
  name      String // e.g., "Grade 1", "Class 10"
  level     Int // Numeric level for sorting
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections     Section[]
  enrollments  ClassEnrollment[]
  subjects     ClassSubject[]
  timetable    Timetable[]
  applications Application[]
}

model Section {
  id             String   @id @default(cuid())
  name           String // e.g., "A", "B", "Science"
  classId        String
  capacity       Int?
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class              Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher       Staff?            @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments        ClassEnrollment[]
  timetable          Timetable[]
  classSubjects      ClassSubject[]
  attendance         Attendance[]
  reports            StudentReport[]
  commentConfigs     ReportCommentConfig[]
  applications       Application[]
  examResultSubmissions ExamResultSubmission[]
}

model ClassEnrollment {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  sectionId      String
  academicYearId String
  status         String   @default("ACTIVE") // ACTIVE, PROMOTED, GRADUATED, REPEATED, WITHDRAWN, TRANSFERRED, EXPELLED, SUSPENDED
  enrolledAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, sectionId, academicYearId])
  @@index([studentId, academicYearId])
  @@index([classId, academicYearId])
  @@index([academicYearId])
}

// Academic Year Management
model AcademicYear {
  id          String   @id @default(cuid())
  year        String   @unique // e.g., "2024-2025"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)
  isUpcoming  Boolean  @default(false) // For next academic year
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terms             Term[]
  enrollments       ClassEnrollment[]
  applications      Application[]
  subjectSelections StudentSubjectSelection[]
  results           Result[]
  fees              Fee[]
  exams             Exam[]
  reports           StudentReport[]
  attendance        Attendance[]
  examResultSubmissions ExamResultSubmission[]

  @@index([isCurrent])
  @@index([isUpcoming])
  @@index([status])
}

// Term Management
model Term {
  id             String   @id @default(cuid())
  name           String   // e.g., "First Term", "Second Term", "Third Term"
  academicYearId String
  termNumber     Int      // 1, 2, 3
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  results      Result[]
  fees         Fee[]
  exams        Exam[]
  reports      StudentReport[]
  attendance   Attendance[]
  examResultSubmissions ExamResultSubmission[]

  @@unique([academicYearId, termNumber])
  @@index([isCurrent])
  @@index([academicYearId])
}

// Staff Management
model Staff {
  id            String    @id @default(cuid())
  userId        String    @unique
  employeeId    String    @unique
  designation   String // TEACHER, PRINCIPAL, ACCOUNTANT, LIBRARIAN, ADMIN
  department    String?
  qualification String?
  experience    Int?
  salary        Float?
  joiningDate   DateTime?
  gender        String?   // MALE, FEMALE, OTHER
  dateOfBirth   DateTime?
  address       String?
  status        String    @default("ACTIVE") // ACTIVE, RESIGNED, RETIRED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  sections           Section[]
  assignments        Assignment[]
  attendance         Attendance[]
  reportComments     ReportComment[]
  commentConfigs     ReportCommentConfig[]
}

// Subject Management
model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  type        String   @default("CORE") // CORE, ELECTIVE, OPTIONAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classSubjects ClassSubject[]
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  sectionId String?
  subjectId String
  teacherId String?
  maxMarks  Float?
  passMarks Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class                   Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  section                 Section?                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject                 Subject                   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher                 Staff?                    @relation(fields: [teacherId], references: [id])
  results                 Result[]
  timetable               Timetable[]
  assignments             Assignment[]              @relation("ClassSubjectAssignments")
  StudentSubjectSelection StudentSubjectSelection[]
  examSubjectSubmissions  ExamSubjectSubmission[]

  @@unique([classId, sectionId, subjectId])
}

// Student Subject Selection (for Elective and Optional subjects)
model StudentSubjectSelection {
  id             String   @id @default(cuid())
  studentId      String
  classSubjectId String
  academicYearId String
  status         String   @default("ACTIVE") // ACTIVE, DROPPED
  selectedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSubjectId, academicYearId])
  @@index([studentId])
  @@index([classSubjectId])
  @@index([academicYearId])
}

// Exam Management
model Exam {
  id               String    @id @default(cuid())
  name             String
  description      String?
  examType         String // MID_TERM, FINAL, QUIZ, ASSIGNMENT, CONTINUOUS_ASSESSMENT
  termId           String
  academicYearId   String
  startDate        DateTime?
  endDate          DateTime?
  isFinal          Boolean   @default(false)
  requiresApproval Boolean   @default(true) // If false, teachers can publish directly
  status           String    @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])
  results      Result[]
  reports      StudentReport[]
  examResultSubmissions ExamResultSubmission[]

  @@index([termId])
  @@index([academicYearId])
}

// Results Management
model Result {
  id             String    @id @default(cuid())
  studentId      String
  classSubjectId String
  termId         String
  academicYearId String
  examId         String? // Link to exam
  marksObtained  Float
  maxMarks       Float
  grade          String?
  remarks        String?
  status         String    @default("DRAFT") // DRAFT, PENDING_CLASS_TEACHER, PENDING_APPROVAL, APPROVED, REJECTED, PUBLISHED
  submittedBy    String? // User ID who submitted
  reviewedBy     String? // Class teacher who reviewed
  approvedBy     String? // Principal who approved
  submittedAt    DateTime?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exam         Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  submitter    User?        @relation("SubmittedResults", fields: [submittedBy], references: [id], onDelete: SetNull)
  reviewer     User?        @relation("ReviewedResults", fields: [reviewedBy], references: [id], onDelete: SetNull)
  approver     User?        @relation("ApprovedResults", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([classSubjectId])
  @@index([termId])
  @@index([academicYearId])
  @@index([examId])
  @@index([status])
}

// Attendance Management
model Attendance {
  id             String   @id @default(cuid())
  studentId      String?
  staffId        String?  // For staff attendance
  sectionId      String?  // Class section for tracking which class
  academicYearId String
  termId         String
  date           DateTime
  status         String   // PRESENT, ABSENT, LATE, EXCUSED
  remarks        String?
  isArchived     Boolean  @default(false) // Auto-archived when term ends
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId, date], name: "studentId_sectionId_date")
  @@index([staffId, date])
  @@index([sectionId, date])
  @@index([academicYearId, termId])
  @@index([isArchived])
  @@index([termId])
}

// Fees Management
model Fee {
  id             String    @id @default(cuid())
  studentId      String
  termId         String
  academicYearId String
  feeType        String // TUITION, LIBRARY, LAB, SPORTS, TRANSPORT
  amount         Float
  dueDate        DateTime
  paidAmount     Float     @default(0)
  paidDate       DateTime?
  status         String    @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  paymentMethod  String?
  transactionId  String?
  remarks        String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [createdBy], references: [id])

  @@index([studentId])
  @@index([termId])
  @@index([academicYearId])
  @@index([status])
}

// Inventory Management
model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  category  String // EQUIPMENT, BOOKS, SUPPLIES, FURNITURE
  quantity  Int      @default(0)
  unit      String // e.g., "pieces", "boxes", "sets"
  minStock  Int      @default(0)
  location  String?
  supplier  String?
  cost      Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  itemId    String
  type      String // IN, OUT, TRANSFER, ADJUSTMENT
  quantity  Int
  reason    String?
  reference String?
  userId    String
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])
}

// Broadcasting/Announcements
model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  type            String // GENERAL, ACADEMIC, EVENT, URGENT
  targetAudience  String // ALL, STUDENTS, PARENTS, STAFF, CLASS
  targetClassId   String?
  targetSectionId String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator User @relation(fields: [createdBy], references: [id])
}

// Timetable Management
model Timetable {
  id             String   @id @default(cuid())
  classId        String
  sectionId      String
  classSubjectId String
  day            String // MONDAY, TUESDAY, etc.
  startTime      String
  endTime        String
  room           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId, day, startTime])
}

// Audit Trail - Track all system activities
model AuditTrail {
  id          String   @id @default(cuid())
  userId      String
  action      String // CREATE, UPDATE, DELETE, VIEW, LOGIN, LOGOUT, etc.
  entityType  String // e.g., "User", "Student", "Result", "Fee"
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    String? // JSON string for additional data
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

// Session Log - Track user login sessions
model SessionLog {
  id         String    @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  deviceType String? // DESKTOP, MOBILE, TABLET
  browser    String?
  os         String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  duration   Int? // Duration in seconds
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([isActive])
}

// Password Reset Token
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Notifications
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // INFO, SUCCESS, WARNING, ERROR
  category  String? // RESULT, ANNOUNCEMENT, FEE, EXAM, etc.
  read      Boolean   @default(false)
  link      String? // Optional link to related page
  metadata  String? // JSON string for additional data
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([category])
}

// Assignment Management
model Assignment {
  id             String   @id @default(cuid())
  title          String
  description    String?
  classSubjectId String
  teacherId      String
  dueDate        DateTime
  maxMarks       Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classSubject       ClassSubject        @relation("ClassSubjectAssignments", fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher            Staff               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentAssignments StudentAssignment[]
}

model StudentAssignment {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  marks        Float?
  feedback     String?
  status       String    @default("PENDING") // PENDING, SUBMITTED, GRADED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// Signature Management
model Signature {
  id             String   @id @default(cuid())
  userId         String   @unique
  signatureType  String? // PRINCIPAL, CLASS_TEACHER
  signatureImage String // Base64 encoded image (stored as text)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Email Configuration (Singleton - only one config should exist)
model EmailConfig {
  id        String   @id @default(cuid())
  host      String
  port      Int
  secure    Boolean  @default(false)
  user      String
  password  String // Encrypted password (consider encrypting in production)
  from      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id]) // Ensure only one config exists
}

// System Settings (Singleton - only one config should exist)
model SystemSettings {
  id                String   @id @default(cuid())
  idleTimeoutMinutes Int      @default(30) // Default 30 minutes
  warningBeforeLogoutMinutes Int @default(5) // Show warning 5 minutes before logout
  isIdleTimeoutEnabled Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([id]) // Ensure only one config exists
}

// Student Reports - Generated reports for students
model StudentReport {
  id               String    @id @default(cuid())
  studentId        String
  sectionId        String
  termId           String
  academicYearId   String
  examId           String?
  totalMarksObtained Float?  // Sum of all core subject marks
  maxTotalMarks    Float?
  positionInClass  Int?      // Student's rank/position
  classSize        Int?      // Total students in class
  progressRatio    Float?    // Compared to last term (percentage improvement/decline)
  previousTermAverage Float? // Previous term's average marks
  currentTermAverage Float?  // Current term's average marks
  
  // Approval workflow
  status           String    @default("DRAFT") // DRAFT, PENDING_CLASS_TEACHER, PENDING_PRINCIPAL, APPROVED, REJECTED
  submittedBy      String?   // Class teacher who submitted
  submittedAt      DateTime?
  approvedBy       String?   // Principal who approved
  approvedAt       DateTime?
  rejectionReason  String?
  
  // Generation tracking
  generatedAt      DateTime  @default(now())
  generatedBy      String    // Teacher/Admin who generated
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section          Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  term             Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exam             Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)
  generator        User         @relation("ReportGenerator", fields: [generatedBy], references: [id])
  submitter        User?        @relation("ReportSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  approver         User?        @relation("ReportApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  
  comments         ReportComment[]
  
  @@unique([studentId, termId, examId])
  @@index([sectionId])
  @@index([termId])
  @@index([academicYearId])
  @@index([status])
}

// Teacher Comments on Student Reports
model ReportComment {
  id               String    @id @default(cuid())
  reportId         String
  teacherId        String
  
  // Comment configuration based on marks
  marksLowerBound  Float?    // Marks range this comment applies to (e.g., 0-40)
  marksUpperBound  Float?    // Upper bound of marks range
  
  commentText      String    // The comment to display
  performanceArea  String?   // OVERALL, CONDUCT, PARTICIPATION, EFFORT, ATTENDANCE
  
  // Signature details
  teacherSignature String?   // Base64 encoded signature image
  signedAt         DateTime?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  report           StudentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  teacher          Staff         @relation(fields: [teacherId], references: [id])
  
  @@index([reportId])
  @@index([teacherId])
}

// Teacher Comment Configuration - Templates for comments based on performance
model ReportCommentConfig {
  id               String    @id @default(cuid())
  teacherId        String
  sectionId        String
  
  // Comment template configuration
  marksLowerBound  Float     // e.g., 0
  marksUpperBound  Float     // e.g., 40
  commentTemplate  String    // Template text (can include {studentName}, {marks}, {average})
  
  performanceArea  String    // OVERALL, CONDUCT, PARTICIPATION, EFFORT, ATTENDANCE
  isActive         Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  teacher          Staff     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section          Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  @@unique([teacherId, sectionId, marksLowerBound, marksUpperBound, performanceArea])
  @@index([sectionId])
}

// Exam Result Submission Tracking - Tracks the submission status of results per exam/section
model ExamResultSubmission {
  id               String    @id @default(cuid())
  examId           String
  sectionId        String
  academicYearId   String
  termId           String
  
  // Subject-level tracking
  totalSubjects    Int       // Total core subjects for this section
  submittedSubjects Int      @default(0) // Number of subjects with all results entered
  
  // Workflow status
  status           String    @default("PENDING_SUBJECTS") // PENDING_SUBJECTS, PENDING_CLASS_TEACHER, PENDING_PRINCIPAL, APPROVED, PUBLISHED
  
  // Class teacher review
  classTeacherReviewedBy   String?
  classTeacherReviewedAt   DateTime?
  classTeacherComments     String?
  
  // Principal approval
  principalApprovedBy      String?
  principalApprovedAt      DateTime?
  principalComments        String?
  
  // Aggregate stats
  totalStudents    Int?
  averageMarks     Float?
  highestMarks     Float?
  lowestMarks      Float?
  passRate         Float?    // Percentage of students who passed
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  exam             Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  section          Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term             Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTeacherReviewer User? @relation("ExamSubmissionReviewer", fields: [classTeacherReviewedBy], references: [id], onDelete: SetNull)
  principalApprover User?    @relation("ExamSubmissionApprover", fields: [principalApprovedBy], references: [id], onDelete: SetNull)
  
  subjectSubmissions ExamSubjectSubmission[]
  
  @@unique([examId, sectionId])
  @@index([examId])
  @@index([sectionId])
  @@index([status])
}

// Tracks individual subject submission status within an exam/section
model ExamSubjectSubmission {
  id                     String    @id @default(cuid())
  examResultSubmissionId String
  classSubjectId         String
  
  // Submission status
  totalStudents          Int       // Expected number of students
  resultsEntered         Int       @default(0) // Actual results entered
  isComplete             Boolean   @default(false) // All students have results
  
  // Teacher tracking
  submittedBy            String?   // Subject teacher who submitted
  submittedAt            DateTime?
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  examResultSubmission   ExamResultSubmission @relation(fields: [examResultSubmissionId], references: [id], onDelete: Cascade)
  classSubject           ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  submitter              User?      @relation("SubjectSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  
  @@unique([examResultSubmissionId, classSubjectId])
  @@index([classSubjectId])
}

// School Configuration (Singleton - stores school-wide settings)
model SchoolConfig {
  id                    String   @id @default(cuid())
  schoolName            String   @default("School Name")
  schoolMotto           String?
  schoolAddress         String?
  schoolPhone           String?
  schoolEmail           String?
  schoolLogo            String?  // Base64 encoded image or file path
  ministryHeader        String?  @default("MINISTRY OF EDUCATION")
  
  // Principal Info
  principalName         String?
  principalSignature    String?  // Base64 encoded signature image
  
  // Default report settings
  reportFooterText      String?
  nextTermDate          DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Remark Templates - Auto-generate remarks based on score ranges
model RemarkTemplate {
  id            String   @id @default(cuid())
  minPercentage Float    // Minimum percentage (inclusive)
  maxPercentage Float    // Maximum percentage (inclusive)
  remark        String   // e.g., "Excellent", "Very Good", "Good", "Fair", "Poor"
  category      String   @default("SUBJECT") // SUBJECT, OVERALL - for subject-level or overall remarks
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([minPercentage, maxPercentage, category])
}

// Comment Templates - Pre-defined comments for teachers/principals
model CommentTemplate {
  id            String   @id @default(cuid())
  minPercentage Float    // Minimum percentage (inclusive)
  maxPercentage Float    // Maximum percentage (inclusive)
  comment       String   // e.g., "Excellent work. Keep it up!"
  commentType   String   // CLASS_TEACHER, PRINCIPAL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([minPercentage, maxPercentage, commentType])
}
