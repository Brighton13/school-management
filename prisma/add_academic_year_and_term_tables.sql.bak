-- Migrate data to new columns
UPDATE "ClassEnrollment" ce
SET "academicYearId" = ay.id
FROM "AcademicYear" ay
WHERE ay.year = ce."academicYear";

UPDATE "Application" a
SET "academicYearId" = ay.id
FROM "AcademicYear" ay
WHERE ay.year = a."academicYear";

UPDATE "StudentSubjectSelection" sss
SET "academicYearId" = ay.id
FROM "AcademicYear" ay
WHERE ay.year = sss."academicYear";

UPDATE "Result" r
SET "termId" = t.id,
    "academicYearId" = t."academicYearId"
FROM "Term" t
WHERE t.id = r."academicTermId";

UPDATE "Fee" f
SET "termId" = t.id,
    "academicYearId" = t."academicYearId"
FROM "Term" t
WHERE t.id = f."academicTermId";

UPDATE "Exam" e
SET "termId" = t.id,
    "academicYearId" = t."academicYearId"
FROM "Term" t
WHERE t.id = e."academicTermId";

UPDATE "StudentReport" sr
SET "termId" = t.id,
    "academicYearId" = t."academicYearId"
FROM "Term" t
WHERE t.id = sr."academicTermId";

