-- CreateTable
CREATE TABLE "AcademicYear" (
    "id" TEXT NOT NULL,
    "year" TEXT NOT NULL,
    "startDate" TIMESTAMP(3) NOT NULL,
    "endDate" TIMESTAMP(3) NOT NULL,
    "isCurrent" BOOLEAN NOT NULL DEFAULT false,
    "isUpcoming" BOOLEAN NOT NULL DEFAULT false,
    "status" TEXT NOT NULL DEFAULT 'ACTIVE',
    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "updatedAt" TIMESTAMP(3) NOT NULL,

    CONSTRAINT "AcademicYear_pkey" PRIMARY KEY ("id")
);

-- CreateTable
CREATE TABLE "Term" (
    "id" TEXT NOT NULL,
    "name" TEXT NOT NULL,
    "academicYearId" TEXT NOT NULL,
    "termNumber" INTEGER NOT NULL,
    "startDate" TIMESTAMP(3) NOT NULL,
    "endDate" TIMESTAMP(3) NOT NULL,
    "isCurrent" BOOLEAN NOT NULL DEFAULT false,
    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "updatedAt" TIMESTAMP(3) NOT NULL,

    CONSTRAINT "Term_pkey" PRIMARY KEY ("id")
);

-- Migrate existing data from AcademicTerm to new structure
-- Step 1: Create academic years from existing terms
INSERT INTO "AcademicYear" (id, year, "startDate", "endDate", "isCurrent", status, "createdAt", "updatedAt")
SELECT 
    gen_random_uuid(),
    "academicYear",
    MIN("startDate"),
    MAX("endDate"),
    MAX(CASE WHEN "isCurrent" THEN true ELSE false END),
    'ACTIVE',
    MIN("createdAt"),
    NOW()
FROM "AcademicTerm"
GROUP BY "academicYear";

-- Step 2: Create terms linked to academic years
INSERT INTO "Term" (id, name, "academicYearId", "termNumber", "startDate", "endDate", "isCurrent", "createdAt", "updatedAt")
SELECT 
    at.id,
    at.name,
    ay.id,
    CASE 
        WHEN at.name ILIKE '%first%' OR at.name ILIKE '%1%' THEN 1
        WHEN at.name ILIKE '%second%' OR at.name ILIKE '%2%' THEN 2
        WHEN at.name ILIKE '%third%' OR at.name ILIKE '%3%' THEN 3
        ELSE ROW_NUMBER() OVER (PARTITION BY at."academicYear" ORDER BY at."startDate")
    END,
    at."startDate",
    at."endDate",
    at."isCurrent",
    at."createdAt",
    at."updatedAt"
FROM "AcademicTerm" at
JOIN "AcademicYear" ay ON ay.year = at."academicYear";

