# Database
# For Supabase PostgreSQL (recommended)
# Get your connection string from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public"

# For local PostgreSQL (development)
# DATABASE_URL="postgresql://user:password@localhost:5432/school_management?schema=public"

# For SQLite (local development only - not recommended for production)
# DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production-use-openssl-rand-base64-32

# App Environment
NODE_ENV=development

